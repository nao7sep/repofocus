{
  "name": "repofocus",
  "displayName": "RepoFocus",
  "description": "Shows only actionable Git repositories in VS Code's native Source Control view.",
  "version": "0.1.3",
  "packageManager": "npm@12.0.2",
  "publisher": "nao7sep",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nao7sep/repofocus.git"
  },
  "bugs": {
    "url": "https://github.com/nao7sep/repofocus/issues"
  },
  "homepage": "https://github.com/nao7sep/repofocus#readme",
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "source-control",
    "multi-repo",
    "repository",
    "vscode-extension"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:workbench.scm",
    "onCommand:workbench.view.scm"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "repofocus.toggle",
        "title": "Toggle Filtering",
        "category": "RepoFocus",
        "icon": "$(filter)"
      },
      {
        "command": "repofocus.refresh",
        "title": "Refresh",
        "category": "RepoFocus",
        "icon": "$(refresh)"
      },
      {
        "command": "repofocus.copyDiagnostics",
        "title": "Copy Diagnostics",
        "category": "RepoFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "repofocus.toggle",
          "when": "view == workbench.scm && repofocus.compatible",
          "group": "navigation@100"
        },
        {
          "command": "repofocus.refresh",
          "when": "view == workbench.scm && repofocus.filteringEnabled && repofocus.compatible",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "title": "RepoFocus",
      "properties": {
        "repofocus.alwaysShow": {
          "type": "array",
          "default": [],
          "scope": "window",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "description": "Git repository glob patterns that remain visible even when clean. A pattern matches a repository's path (workspace-relative where it has one) or its directory name, so a bare name such as 'my-repo' works in any workspace shape."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && node scripts/run-integration-tests.mjs",
    "check": "npm run typecheck && npm test",
    "vscode:prepublish": "npm run check && npm run build"
  },
  "dependencies": {
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.125.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": false,
    "esbuild@0.28.2": false,
    "fsevents@2.3.3": false,
    "keytar@7.9.0": false
  }
}
